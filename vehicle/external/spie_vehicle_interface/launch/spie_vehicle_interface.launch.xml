<launch>
    <node pkg="spie_vehicle_interface" exec="spie_vehicle_interface_exec" name="spie_vehicle_interface_node" output="screen">
        <param name="port" value="/dev/serial/by-id/usb-Seeed_XIAO_nRF52840_Sense_C0ABD75A4022435C-if00"/>
        <param name="gyro_base_x" value="-0.0028"/>
        <param name="gyro_base_y" value="0.1000"/>
        <param name="gyro_base_z" value="0.0268"/>
    </node>
    
    <node pkg="imu_complementary_filter" name="complementary_filter_node" exec="complementary_filter_node">
        <param name="do_bias_estimation" value="false" />
        
        <remap from="imu/data" to="/sensing/imu/imu_data" />
    </node>

    <include file="$(find-pkg-share rosbridge_server)/launch/rosbridge_websocket_launch.xml">
    </include>
    
    <!--<node pkg="web_video_server" exec="web_video_server" name="web_video_server_node" output="screen">
        <param name="port" value="8080"/>
        <param name="address" value="0.0.0.0"/>
    </node>-->
</launch>
